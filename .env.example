# ============================================================
# Industrial Failure Mechanism Discovery - Environment Config
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ifmd_db
POSTGRES_USER=ifmd_user
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://ifmd_user:changeme_strong_password@localhost:5432/ifmd_db
DATABASE_URL_SYNC=postgresql://ifmd_user:changeme_strong_password@localhost:5432/ifmd_db

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2
SECRET_KEY=changeme_very_long_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- LLM (optional - system works without it) ---
LLM_PROVIDER=none
# Options: none | openai | google | ollama
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Data ---
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=100

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Research ---
EXPERIMENT_OUTPUT_DIR=./research/results
RANDOM_SEED=42

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=Industrial Failure Mechanism Discovery
